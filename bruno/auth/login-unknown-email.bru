meta {
  name: Login unknown email
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "vendedora@cafecitofeliz.com",
    "password": "c1aveSegura"
  }
}

tests {
  test("responds 401 with the same body as a wrong password", function () {
    expect(res.status).to.equal(401);
    expect(res.body).to.eql({
      error: "Invalid credentials",
      message: "Email or password is incorrect"
    });
  });
}
