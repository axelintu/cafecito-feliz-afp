meta {
  name: Login admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@cafecitofeliz.com",
    "password": "s3cretosDePassword"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.token);
}

tests {
  test("responds 200 with a token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
  });
}
