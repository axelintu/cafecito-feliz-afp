meta {
  name: Search "té"
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/products?q=té
  body: none
  auth: none
}

params:query {
  q: té
}

tests {
  test("responds 200 with data and total", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.total).to.equal(res.body.data.length);
  });

  // The accent in the input is ignored, so "té" also finds "Latte".
  test("finds the same as \"te\"", function () {
    const names = res.body.data.map((product) => product.name);
    expect(names).to.eql(["Café Latte", "Té Verde"]);
  });
}
