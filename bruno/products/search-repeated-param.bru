meta {
  name: Search repeated q
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/products?q=a&q=b
  body: none
  auth: none
}

params:query {
  q: a
  q: b
}

tests {
  test("responds 200 with data and total", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.total).to.equal(res.body.data.length);
  });

  // Express turns ?q=a&q=b into the array ['a', 'b']: not a 500.
  test("ignores a repeated q and returns the full list", function () {
    const names = res.body.data.map((product) => product.name);
    expect(names).to.eql(["Café Americano", "Café Latte", "Capuchino", "Té Verde"]);
  });
}
