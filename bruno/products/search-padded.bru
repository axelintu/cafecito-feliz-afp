meta {
  name: Search " cafe " with spaces
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/products?q=%20cafe%20
  body: none
  auth: none
}

params:query {
  q: %20cafe%20
}

tests {
  test("responds 200 with data and total", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.total).to.equal(res.body.data.length);
  });

  // The spaces around "cafe" are trimmed before building the regex.
  test("trims the spaces and finds the same as \"cafe\"", function () {
    const names = res.body.data.map((product) => product.name);
    expect(names).to.eql(["Café Americano", "Café Latte"]);
  });
}
